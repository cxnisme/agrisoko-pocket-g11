import React, { useState, useEffect } from 'react';
import { StyleSheet, Text, TextInput, TouchableOpacity, View, ScrollView, ActivityIndicator, Linking } from 'react-native';
import NetInfo from '@react-native-community/netinfo';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { teamApi, AskResponse } from '../service/api';


export default function AskScreen() {
  const [query, setQuery] = useState('');
  const [loading, setLoading] = useState(false);
  const [isOnline, setIsOnline] = useState(true);
  const [resultSource, setResultSource] = useState<'live' | 'cached' | 'offline'>('live');
  const [matchResult, setMatchResult] = useState<AskResponse | null>(null);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  // Monitor connectivity status live via NetInfo
  useEffect(() => {
    const unsubscribe = NetInfo.addEventListener(state => {
      setIsOnline(!!state.isConnected);
    });
    return () => unsubscribe();
  }, []);

  const handleAskTeam = async () => {
    const cleanQuery = query.trim();
    
    // Validate empty boundaries
    if (cleanQuery.length < 2) {
      setErrorMessage('Please type a descriptive question containing at least 2 characters.');
      return;
    }

    setLoading(true);
    setErrorMessage(null);
    setMatchResult(null);

    // --- CASE A: SYSTEM RUNNING OFFLINE FALLBACK MODE ---
    if (!isOnline) {
      setResultSource('offline');
      try {
        // Fetch bundled fallback directory matrix data from local storage
        const cachedRaw = await AsyncStorage.getItem('@members_directory');
        if (cachedRaw) {
          const members = JSON.parse(cachedRaw);
          // Look for direct exact text containment match on name or aliases locally
          const found = members.find((m: any) => 
            m.fullName.toLowerCase().includes(cleanQuery.toLowerCase()) ||
            m.aliases.some((a: string) => a.toLowerCase().includes(cleanQuery.toLowerCase()))
          );

          if (found) {
            setMatchResult({
              query: cleanQuery,
              top_match: found.fullName,
              confidence: 1.0,
              reason: 'Exact structural match located within local offline AsyncStorage cache.',
              introduction: found.introductionDraft,
              evidence_links: found.evidenceLinks,
              model_version: 'local-offline-v1'
            });
          } else {
            setErrorMessage('Offline Mode: No matching team member found by that name or alias. Reconnect to query the full AI model.');
          }
        } else {
          setErrorMessage('System is offline and local fallback directory data cache is uninitialized.');
        }
      } catch (err) {
        setErrorMessage('Failed to query local data storage arrays.');
      } finally {
        setLoading(false);
      }
      return;
    }

    // --- CASE B: SYSTEM RUNNING ONLINE MACHINE LEARNING MODE ---
    try {
      setResultSource('live');
      const apiData = await teamApi.askQuestion(cleanQuery);
      setMatchResult(apiData);
      
      // Cache successful profiles to storage for subsequent offline display stability
      if (apiData.top_match) {
        await AsyncStorage.setItem(`@cache_profile_${apiData.top_match}`, JSON.stringify(apiData));
      }
    } catch (error: any) {
      // Gracefully recover connection failures by loading the last available cache block
      setResultSource('cached');
      setErrorMessage('Server connection timed out or unavailable. Displaying local data cache.');
      try {
        const lastSuccess = await AsyncStorage.getItem('@last_successful_profile');
        if (lastSuccess) {
          setMatchResult(JSON.parse(lastSuccess));
        }
      } catch (cacheErr) {
        console.error('Could not pull storage recovery records.');
      }
    } finally {
      setLoading(false);
    }
  };

  return (
    <ScrollView contentContainerStyle={styles.container}>
      {/* Network Connectivity Status Bar Banner Banner Component */}
      <View style={[styles.networkBanner, isOnline ? styles.onlineBg : styles.offlineBg]}>
        <Text style={styles.bannerText}>
          System Status: {isOnline ? '🟢 Connected Live' : '🟠 Offline Mode Active'}
        </Text>
      </View>

      <Text style={styles.title}>AgriSoko Pocket AI Search</Text>
      <Text style={styles.subtitle}>Ask questions about our team roles, skills, or system contributions below.</Text>

      <TextInput
        style={styles.inputField}
        placeholder="e.g., Who built the offline mode storage layers?"
        placeholderTextColor="#7f8c8d"
        value={query}
        onChangeText={(text) => {
          setQuery(text);
          if (errorMessage) setErrorMessage(null);
        }}
      />

      <TouchableOpacity style={styles.searchButton} onPress={handleAskTeam} disabled={loading}>
        {loading ? <ActivityIndicator color="#fff" /> : <Text style={styles.buttonText}>Query Team Index</Text>}
      </TouchableOpacity>

      {/* Validation Error Presentation Boundary */}
      {errorMessage && <Text style={styles.errorBox}>{errorMessage}</Text>}

      {/* Response Data Rendering Layout Box */}
      {matchResult && (
        <View style={styles.resultCard}>
          <View style={styles.badgeRow}>
            <Text style={[styles.sourceBadge, styles[`badge_${resultSource}` as keyof typeof styles]]}>
              Source: {resultSource.toUpperCase()}
            </Text>
            {matchResult.top_match && (
              <Text style={styles.confidenceScore}>
                Confidence: {(matchResult.confidence * 100).toFixed(1)}%
              </Text>
            )}
          </View>

          <Text style={styles.sectionHeading}>Matched Member:</Text>
          <Text style={styles.profileName}>{matchResult.top_match || 'No Match Discovered'}</Text>

          <Text style={styles.sectionHeading}>Matching Criterion Reason:</Text>
          <Text style={styles.bodyDescription}>{matchResult.reason}</Text>

          <Text style={styles.sectionHeading}>Grounded Technical Profile Introduction:</Text>
          <Text style={styles.introQuote}>"{matchResult.introduction}"</Text>

          {matchResult.evidence_links.length > 0 && (
            <View>
              <Text style={styles.sectionHeading}>Verifiable Project Evidence Links:</Text>
              {matchResult.evidence_links.map((link, idx) => (
                <TouchableOpacity key={idx} onPress={() => Linking.openURL(link)}>
                  <Text style={styles.urlLinkText}>🔗 {link}</Text>
                </TouchableOpacity>
              ))}
            </View>
          )}
        </View>
      )}
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { padding: 20, backgroundColor: '#f8f9fa' },
  networkBanner: { padding: 8, borderRadius: 6, marginBottom: 20, alignItems: 'center' },
  onlineBg: { backgroundColor: '#e8f5e9' },
  offlineBg: { backgroundColor: '#ffe0b2' },
  bannerText: { fontSize: 13, fontWeight: 'bold', color: '#2c3e50' },
  title: { fontSize: 24, fontWeight: 'bold', color: '#1a252f', marginBottom: 6 },
  subtitle: { fontSize: 14, color: '#7f8c8d', marginBottom: 20 },
  inputField: { backgroundColor: '#fff', borderWidth: 1, borderColor: '#bdc3c7', borderRadius: 8, padding: 12, fontSize: 16, color: '#2c3e50', marginBottom: 12 },
  searchButton: { backgroundColor: '#2c3e50', padding: 14, borderRadius: 8, alignItems: 'center' },
  buttonText: { color: '#fff', fontSize: 16, fontWeight: 'bold' },
  errorBox: { color: '#c0392b', backgroundColor: '#fdedec', padding: 10, borderRadius: 6, marginTop: 12, fontWeight: '500' },
  resultCard: { backgroundColor: '#fff', borderRadius: 10, padding: 16, marginTop: 20, borderWidth: 1, borderColor: '#e2e8f0', elevation: 2 },
  badgeRow: { flexDirection: 'row', justifyContent: 'space-between', marginBottom: 14 },
  sourceBadge: { paddingHorizontal: 8, paddingVertical: 4, borderRadius: 4, fontSize: 11, fontWeight: 'bold', overflow: 'hidden', color: '#fff' },
  badge_live: { backgroundColor: '#2ca02c' },
  badge_offline: { backgroundColor: '#ff7f0e' },
  badge_cached: { backgroundColor: '#1f77b4' },
  confidenceScore: { fontSize: 13, fontWeight: 'bold', color: '#7f8c8d' },
  sectionHeading: { fontSize: 12, fontWeight: 'bold', color: '#95a5a6', textTransform: 'uppercase', marginTop: 12, marginBottom: 2 },
  profileName: { fontSize: 20, fontWeight: 'bold', color: '#2c3e50' },
  bodyDescription: { fontSize: 14, color: '#34495e', lineHeight: 20 },
  introQuote: { fontSize: 15, fontStyle: 'italic', color: '#2c3e50', backgroundColor: '#f1f2f6', padding: 10, borderRadius: 6, marginVertical: 6, lineHeight: 22 },
  urlLinkText: { color: '#2980b9', fontSize: 13, textDecorationLine: 'underline', marginTop: 4 },
});
